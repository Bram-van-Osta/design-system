{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/*.md", "!**/*.mdx"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case", "PascalCase"]
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": "error",
        "noUndeclaredDependencies": "error"
      },
      "nursery": {
        "noUnsafeTypeAssertion": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/ui/src/**",
        "!**/*.stories.tsx",
        "!**/*.test.ts",
        "!packages/ui/src/testing/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!react",
                      "!@base-ui/react/*",
                      "!@phosphor-icons/react",
                      "!./**",
                      "!../**"
                    ],
                    "message": "A component imports only React, Base UI, Phosphor and the package itself: its data, its navigation and its network are the app's, through its props."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "The network is the app's: the component receives the action as a prop.",
                  "XMLHttpRequest": "The network is the app's: the component receives the action as a prop.",
                  "WebSocket": "The network is the app's: the component receives the action as a prop.",
                  "EventSource": "The network is the app's: the component receives the action as a prop."
                }
              }
            }
          }
        }
      }
    }
  ]
}
