{
  "name": "@bram-van-osta/ui",
  "version": "0.3.0",
  "description": "The Bram van Osta React components, on Base UI and the tokens, styled with Tailwind 4.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bram-van-Osta/design-system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://bram-van-osta.github.io/design-system/",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@bram-van-osta/tokens": "workspace:*",
    "@phosphor-icons/react": "2.1.10"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@storybook/react-vite": "10.6.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.6.2",
    "typescript": "catalog:",
    "vite": "8.3.4",
    "vitest": "catalog:"
  }
}
